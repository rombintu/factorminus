TINVEST_MCP_URL=https://invest-public-api.tbank.ru/mcp
TINVEST_CA_BUNDLE=
FM_DB_PATH=data/fm.sqlite
# Необязательно: корень проекта (по умолчанию каталог с pyproject.toml) и каталог данных
# времени выполнения (по умолчанию <корень>/data). Читаются только из окружения, не из .env.
# В Docker их задаёт образ и compose.yaml.
# FM_HOME=
# FM_DATA_DIR=
# Тег образа для docker compose (по умолчанию main), например FM_TAG=v0.1.5
# FM_TAG=
