# Токен песочницы T-Invest API (Sandbox token): реальных счетов не видит. Боевой токен не нужен.
TINVEST_TOKEN=
TINVEST_MCP_URL=https://sandbox-invest-public-api.tbank.ru/mcp
# Необязательно: корень проекта (по умолчанию каталог с pyproject.toml) и каталог данных
# времени выполнения (по умолчанию <корень>/data). Читаются только из окружения, не из .env.
# В Docker их задаёт образ и compose.yaml.
# FM_HOME=
# FM_DATA_DIR=
# Необязательно: путь к SQLite. По умолчанию <FM_DATA_DIR>/fm.sqlite; относительный путь
# считается от корня проекта, а не от FM_DATA_DIR.
# FM_DB_PATH=
# Тег образа для docker compose (по умолчанию latest), например FM_TAG=v0.1.5
# FM_TAG=
